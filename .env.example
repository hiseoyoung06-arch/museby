# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random long random string used to sign the brand & admin session cookies.
# Generate with: openssl rand -hex 32
BRAND_SESSION_SECRET=change-me-to-a-long-random-string

# 뮤즈바이 관리자 로그인: 이 도메인으로 끝나는 이메일 + 아래 비밀번호면 누구나 로그인됩니다.
ADMIN_EMAIL_DOMAIN=whitecube.co.kr
ADMIN_PASSWORD=change-me
